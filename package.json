    "axios": "^1.15.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.14.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  }
}
